---
import Polaroid from './Polaroid.astro';
import { slugifyEra } from '../lib/projects.js';

const { project, swapLabels = false } = Astro.props;
const { title, era, tags, cover } = project.data;
const href = `/work/${slugifyEra(era)}/`;
const caption = swapLabels ? era : title;
const metaPrimary = swapLabels ? title : era;
---
<a class="project-card" href={href} data-era={era} data-tags={tags.join(',')}>
  <Polaroid src={cover} alt={title} caption={caption} />
  <p class="meta">{metaPrimary} · {tags.join(', ')}</p>
</a>

<style>
  .project-card {
    display: inline-block;
    text-decoration: none;
    color: inherit;
    margin: var(--space-3);
    min-width: 0;
  }
  .project-card .meta {
    font-size: 0.85rem;
    color: var(--color-ink-soft);
    text-align: center;
  }
</style>
