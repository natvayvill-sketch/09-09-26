---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Polaroid from '../../components/Polaroid.astro';
import { visibleProjects, groupByEra, groupByType, slugifyEra, isVintageEra } from '../../lib/projects.js';

const tilts = ['var(--tilt-a)', 'var(--tilt-b)', 'var(--tilt-c)', 'var(--tilt-d)'];

export async function getStaticPaths() {
  const allProjects = await getCollection('projects');
  const characters = visibleProjects(allProjects);
  const eras = groupByEra(characters);
  const seenSlugs = new Map();
  return eras.map(({ era, characters: eraCharacters }) => {
    const slug = slugifyEra(era);
    if (slug === '') {
      throw new Error(`slugifyEra produced an empty slug for era "${era}". Give it a name with at least one letter or number.`);
    }
    if (seenSlugs.has(slug)) {
      throw new Error(`Eras "${seenSlugs.get(slug)}" and "${era}" both slugify to "${slug}". Rename one so their URLs don't collide.`);
    }
    seenSlugs.set(slug, era);
    return {
      params: { era: slug },
      props: { era, characters: eraCharacters },
    };
  });
}

const { era, characters } = Astro.props;
const bodyGroups = groupByType(characters);
const tocEntries = characters.flatMap((character) =>
  character.data.panels.map((panel, index) => ({
    id: `${character.id}-${index}`,
    title: panel.title,
  })),
);
---
<PageLayout title={era}>
  <p><a href="/work/">← Back to scrapbook</a></p>
  <h1>{era}</h1>

  <nav class="toc" aria-label="Table of contents">
    <ul>
      {tocEntries.map((entry) => (
        <li><a href={`#${entry.id}`}>{entry.title}</a></li>
      ))}
    </ul>
  </nav>

  {bodyGroups.map(({ type, characters: typeCharacters }) => (
    <section class="type-section">
      <h2>{type}</h2>
      {typeCharacters.map((character) => {
        const { title, tags, panels, tools, links } = character.data;
        return (
          <article class="character">
            <h3>{title}</h3>
            <p class="meta">{era} · {tags.join(', ')}</p>
            <div class="panel-stack">
              {panels.map((panel, index) => (
                <div id={`${character.id}-${index}`} tabindex="-1" class="panel">
                  {index === 0 && <p class="panel-chapter-title">{era}</p>}
                  <Polaroid
                    src={panel.image}
                    alt={panel.title}
                    caption={panel.title}
                    rotate={tilts[index % tilts.length]}
                    vintage={isVintageEra(era)}
                  />
                  <p class="panel-caption">{panel.caption}</p>
                </div>
              ))}
            </div>
            {tools.length > 0 && (
              <p><strong>Tools:</strong> {tools.join(', ')}</p>
            )}
            {links.length > 0 && (
              <ul class="links">
                {links.map((link) => (
                  <li><a href={link.url}>{link.label}</a></li>
                ))}
              </ul>
            )}
          </article>
        );
      })}
    </section>
  ))}
</PageLayout>

<style>
  .toc {
    margin: var(--space-4) 0;
    padding: var(--space-3);
    background: var(--color-paper-dark);
    border: 1px solid var(--color-ink-soft);
  }
  .toc ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .toc a {
    display: inline-block;
    font-family: var(--font-body);
    background: #fff;
    border: 1px solid var(--color-ink-soft);
    border-radius: 999px;
    padding: var(--space-1) var(--space-3);
    text-decoration: none;
  }
  .type-section {
    margin-bottom: var(--space-6);
  }
  .type-section h2 {
    text-transform: capitalize;
  }
  .character {
    margin-bottom: var(--space-5);
  }
  .panel-stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    margin: var(--space-4) 0;
  }
  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 32rem;
  }
  .panel-chapter-title {
    font-family: var(--font-chapter-title);
    font-size: 1.5rem;
    color: var(--color-stain);
    margin: 0 0 var(--space-2);
  }
  .panel-caption {
    font-family: var(--font-body);
    margin: var(--space-4) 0 0;
    text-align: center;
  }
</style>
