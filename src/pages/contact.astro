---
import PageLayout from '../layouts/PageLayout.astro';
import TapeStrip from '../components/TapeStrip.astro';
---
<PageLayout title="Contact">
  <article class="letter">
    <div class="letter-tape"><TapeStrip rotate="var(--tilt-a)" /></div>
    <h1>Dear visitor,</h1>
    <p>
      Thanks for wandering through my pages. Whether you have a project in
      mind, a question, or just want to say hi, I'd love to hear from you.
      Drop me a postcard below and I'll write back soon.
    </p>
    <p class="signature">— Lee</p>

    <p class="ps">
      <span class="paperclip" aria-hidden="true"></span>
      P.S. My resume is enclosed:{" "}
      <a href="/Lee-Vaylon-Resume.pdf" download="Lee-Vaylon-Resume.pdf">download it (PDF)</a>
    </p>
    <p class="ps">
      P.P.S. Rather send an email? <a href="mailto:natvayvill@gmail.com">natvayvill@gmail.com</a>
    </p>
  </article>

  <form class="postcard" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/contact/thanks/">
    <input type="hidden" name="form-name" value="contact" />
    <p class="honeypot" aria-hidden="true">
      <label>Don't fill this out: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>

    <div class="postcard-message">
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="7" required></textarea>
    </div>

    <div class="postcard-divider" aria-hidden="true"></div>

    <div class="postcard-address">
      <p class="to" aria-hidden="true">To: Lee</p>

      <div class="address-line">
        <label for="name">From</label>
        <input id="name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="address-line">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>

      <!-- Last in the code so keyboard users reach it after the fields; shown top-right like a real stamp. -->
      <button class="stamp" type="submit">
        <span>Send</span>
      </button>
    </div>
  </form>
</PageLayout>

<style>
  /* Shared paper look for the letter and the postcard. */
  .letter,
  .postcard {
    position: relative;
    background: #fbf6ea;
    box-shadow: 0 2px 8px rgba(58, 47, 40, 0.18);
    max-width: 40rem;
    margin-inline: auto;
  }

  /* --- The letter --- */
  .letter {
    --rule: 2rem;
    padding: var(--space-5) var(--space-5) var(--space-4) 4rem;
    transform: rotate(var(--tilt-b));
    margin-bottom: var(--space-6);
    font-family: var(--font-heading);
    font-size: 1.45rem;
    line-height: var(--rule);
    /* Ruled lines plus a red margin line, like notebook paper. */
    background-image:
      linear-gradient(to right, transparent 2.9rem, #d98a80 2.9rem, #d98a80 calc(2.9rem + 1px), transparent calc(2.9rem + 1px)),
      repeating-linear-gradient(to bottom, transparent 0, transparent calc(var(--rule) - 1px), #c9d6de calc(var(--rule) - 1px), #c9d6de var(--rule));
    background-position: 0 0, 0 calc(var(--space-5) - 0.35rem);
  }
  .letter-tape {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
  }
  .letter h1 {
    font-size: 2.2rem;
    line-height: var(--rule);
    margin: 0 0 var(--rule);
    color: var(--color-ink);
  }
  .letter p {
    margin: 0 0 var(--rule);
  }
  .signature {
    text-align: right;
    font-size: 1.7rem;
  }
  .ps {
    color: var(--color-accent-teal);
    margin-bottom: 0 !important;
  }
  .ps a {
    color: var(--color-accent-red);
  }
  .paperclip {
    display: inline-block;
    width: 0.6rem;
    height: 1.5rem;
    border: 2px solid #8b8b8b;
    border-radius: 0.4rem;
    vertical-align: middle;
    margin-right: var(--space-2);
    transform: rotate(var(--tilt-d));
  }

  /* --- The postcard --- */
  .postcard {
    display: grid;
    grid-template-columns: 1.3fr 1px 1fr;
    gap: var(--space-4);
    padding: var(--space-4);
    transform: rotate(var(--tilt-c));
    margin-bottom: var(--space-5);
    font-family: var(--font-heading);
    font-size: 1.3rem;
  }
  .postcard label {
    color: var(--color-ink-soft);
  }
  .postcard-message {
    display: flex;
    flex-direction: column;
  }
  .postcard-message textarea {
    --rule: 2rem;
    flex: 1;
    resize: vertical;
    border: none;
    padding: 0 var(--space-1);
    font-family: var(--font-heading);
    font-size: 1.35rem;
    line-height: var(--rule);
    color: var(--color-ink);
    background: repeating-linear-gradient(to bottom, transparent 0, transparent calc(var(--rule) - 1px), #cfc2a8 calc(var(--rule) - 1px), #cfc2a8 var(--rule));
    background-attachment: local;
  }
  .postcard-divider {
    background: #cfc2a8;
  }
  .postcard-address {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .to {
    margin: 0;
    font-size: 1.6rem;
    color: var(--color-ink);
  }
  .address-line {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .address-line input {
    flex: 1;
    min-width: 0;
    border: none;
    border-bottom: 1.5px solid var(--color-ink-soft);
    background: transparent;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    color: var(--color-ink);
    padding: 0 var(--space-1);
  }

  /* Visible focus: a soft teal highlight, not just the default ring. */
  .postcard input:focus-visible,
  .postcard textarea:focus-visible {
    outline: 2px solid var(--color-accent-teal);
    outline-offset: 2px;
    background-color: rgba(47, 111, 106, 0.06);
  }

  /* The stamp is the send button. */
  .stamp {
    order: -1;
    align-self: flex-end;
    width: 4.5rem;
    height: 5.25rem;
    padding: 0.3rem;
    border: none;
    cursor: pointer;
    background: #fbf6ea;
    /* Perforated edge via a dotted outline around a red stamp face. */
    outline: 3px dotted var(--color-accent-red);
    outline-offset: -3px;
    transform: rotate(var(--tilt-d));
    transition: transform 0.2s ease;
  }
  .stamp span {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    background: var(--color-accent-red);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 1.4rem;
  }
  .stamp:hover {
    animation: wobble 0.4s ease;
  }
  .stamp:focus-visible {
    outline: 3px solid var(--color-accent-teal);
    outline-offset: 3px;
  }
  @keyframes wobble {
    0%, 100% { transform: rotate(var(--tilt-d)); }
    30% { transform: rotate(-2deg); }
    65% { transform: rotate(7deg); }
  }

  .honeypot {
    position: absolute;
    left: -9999px;
  }

  /* Phones: stack the postcard, message first, address side below. */
  @media (max-width: 40rem) {
    .letter {
      padding: var(--space-4) var(--space-3) var(--space-3) 3.25rem;
      background-image:
        linear-gradient(to right, transparent 2.4rem, #d98a80 2.4rem, #d98a80 calc(2.4rem + 1px), transparent calc(2.4rem + 1px)),
        repeating-linear-gradient(to bottom, transparent 0, transparent calc(var(--rule) - 1px), #c9d6de calc(var(--rule) - 1px), #c9d6de var(--rule));
      background-position: 0 0, 0 calc(var(--space-4) - 0.35rem);
    }
    .postcard {
      grid-template-columns: 1fr;
    }
    .postcard-divider {
      height: 1px;
    }
  }
</style>
